{
  "name": "voicechanger",
  "version": "1.0.0",
  "description": "Realtime microphone voice changer for Windows calls",
  "type": "module",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist:win": "node scripts/dist-win.mjs"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.voicechanger.desktop",
    "productName": "VoiceChanger",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "renderer/**/*",
      "assets/icon.ico",
      "package.json"
    ],
    "win": {
      "icon": "assets/icon.ico",
      "target": [
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "VoiceChanger-${version}-portable.${ext}"
    }
  }
}